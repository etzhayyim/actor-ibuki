                           "methods/test_health.cljk"
                           "methods/test_perception.cljk"
                           "methods/test_kaizen_outcomes.cljk"
                           "methods/test_coscientist.cljk"
                           "methods/test_joucho.cljk"
                           "methods/test_heartbeat.cljk"
                           "methods/test_delegation.cljk"
                           "methods/test_drainer.cljk"
                           "methods/test_fleet.cljk"
                           "methods/test_integration.cljk"
                           "methods/test_wellbecoming.cljk"
                           "methods/test_ecosystem.cljk"
                           "methods/test_sick_colony.cljk"
                           "methods/test_digest.cljk"
                           "methods/test_datoms.cljk"
                           "methods/test_metabolism.cljk"
                           "methods/test_kotoba_bridge.cljk"
                           "methods/test_quorum.cljk"
                           "methods/test_infer.cljk"
                           "methods/test_member_submit.cljk"
                           "methods/test_symbiosis.cljk"
                           "methods/test_kaizen_feedback.cljk"
                           "methods/test_autorun.cljk"
                           "methods/test_charter_invariants.cljk"]]
                  (load-file f))
                (let [result (apply t/run-tests
                                    '[ibuki.methods.test-react-loop
                                      ibuki.methods.test-health
