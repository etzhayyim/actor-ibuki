         :git/sha "47a83883ce0ca91d6cda978c8fd03f38192c3887"}}
 :tasks
 {test {:doc "Run ibuki .cljc tests"
        :requires ([clojure.test :as t])
        :task (do
                (doseq [f ["methods/_edn.cljk"
